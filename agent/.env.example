# Copy this file to .env.local and fill in the key. .env.local is never committed.

# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any model id that supports tool calling. To see which free ones respond right now:
#   python -m site_agent.list_models --check
# AGENT_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional. Any OpenAI-compatible endpoint works; the default is OpenRouter.
# AGENT_BASE_URL=https://openrouter.ai/api/v1
